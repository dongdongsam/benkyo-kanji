<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tailscale Light Theme Colors -->
    <Color x:Key="BgCanvasColor">#f8fafc</Color>
    <Color x:Key="BgSidebarColor">#ffffff</Color>
    <Color x:Key="BgCardColor">#ffffff</Color>
    <Color x:Key="BgCardSecondaryColor">#f1f5f9</Color>
    <Color x:Key="BgCardHoverColor">#e2e8f0</Color>
    <Color x:Key="BorderColor">#e2e8f0</Color>
    <Color x:Key="BorderLightColor">#cbd5e1</Color>

    <Color x:Key="AccentColor">#4f46e5</Color>
    <Color x:Key="AccentHoverColor">#4338ca</Color>
    <Color x:Key="AccentMutedColor">#3730a3</Color>

    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColor">#d97706</Color>
    <Color x:Key="DangerColor">#dc2626</Color>
    <Color x:Key="InfoColor">#0284c7</Color>

    <Color x:Key="TextPrimaryColor">#0f172a</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#64748b</Color>

    <!-- Badge / Pill Tints -->
    <Color x:Key="PillBgColor">#f1f5f9</Color>
    <Color x:Key="NavActiveBgColor">#eef2ff</Color>
    <Color x:Key="KanjiBoxBgColor">#f8fafc</Color>
    <Color x:Key="AccentBadgeBgColor">#e0e7ff</Color>
    <Color x:Key="SuccessBadgeBgColor">#d1fae5</Color>
    <Color x:Key="DangerBadgeBgColor">#fee2e2</Color>
    <Color x:Key="WarningBadgeBgColor">#fef3c7</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardSecondaryBrush" Color="{StaticResource BgCardSecondaryColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="PillBgBrush" Color="{StaticResource PillBgColor}" />
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="{StaticResource NavActiveBgColor}" />
    <SolidColorBrush x:Key="KanjiBoxBgBrush" Color="{StaticResource KanjiBoxBgColor}" />
    <SolidColorBrush x:Key="AccentBadgeBgBrush" Color="{StaticResource AccentBadgeBgColor}" />
    <SolidColorBrush x:Key="SuccessBadgeBgBrush" Color="{StaticResource SuccessBadgeBgColor}" />
    <SolidColorBrush x:Key="DangerBadgeBgBrush" Color="{StaticResource DangerBadgeBgColor}" />
    <SolidColorBrush x:Key="WarningBadgeBgBrush" Color="{StaticResource WarningBadgeBgColor}" />

</ResourceDictionary>
