<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tailscale Dark Theme Colors -->
    <Color x:Key="BgCanvasColor">#131217</Color>
    <Color x:Key="BgSidebarColor">#18171d</Color>
    <Color x:Key="BgCardColor">#1e1d24</Color>
    <Color x:Key="BgCardSecondaryColor">#26252e</Color>
    <Color x:Key="BgCardHoverColor">#302f3a</Color>
    <Color x:Key="BorderColor">#2e2d39</Color>
    <Color x:Key="BorderLightColor">#3d3c4c</Color>

    <Color x:Key="AccentColor">#6366f1</Color>
    <Color x:Key="AccentHoverColor">#818cf8</Color>
    <Color x:Key="AccentMutedColor">#4f46e5</Color>

    <Color x:Key="SuccessColor">#10b981</Color>
    <Color x:Key="WarningColor">#f59e0b</Color>
    <Color x:Key="DangerColor">#ef4444</Color>
    <Color x:Key="InfoColor">#0ea5e9</Color>

    <Color x:Key="TextPrimaryColor">#f9fafb</Color>
    <Color x:Key="TextSecondaryColor">#9ca3af</Color>
    <Color x:Key="TextMutedColor">#6b7280</Color>

    <!-- Badge / Pill Tints -->
    <Color x:Key="PillBgColor">#252433</Color>
    <Color x:Key="NavActiveBgColor">#282738</Color>
    <Color x:Key="KanjiBoxBgColor">#181722</Color>
    <Color x:Key="AccentBadgeBgColor">#1e1b4b</Color>
    <Color x:Key="SuccessBadgeBgColor">#064e3b</Color>
    <Color x:Key="DangerBadgeBgColor">#450a0a</Color>
    <Color x:Key="WarningBadgeBgColor">#451a03</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardSecondaryBrush" Color="{StaticResource BgCardSecondaryColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="PillBgBrush" Color="{StaticResource PillBgColor}" />
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="{StaticResource NavActiveBgColor}" />
    <SolidColorBrush x:Key="KanjiBoxBgBrush" Color="{StaticResource KanjiBoxBgColor}" />
    <SolidColorBrush x:Key="AccentBadgeBgBrush" Color="{StaticResource AccentBadgeBgColor}" />
    <SolidColorBrush x:Key="SuccessBadgeBgBrush" Color="{StaticResource SuccessBadgeBgColor}" />
    <SolidColorBrush x:Key="DangerBadgeBgBrush" Color="{StaticResource DangerBadgeBgColor}" />
    <SolidColorBrush x:Key="WarningBadgeBgBrush" Color="{StaticResource WarningBadgeBgColor}" />

</ResourceDictionary>
