<UserControl x:Class="BenkyoKanji.Views.WorksheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:BenkyoKanji.Converters"
             xmlns:models="clr-namespace:BenkyoKanji.Models"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVisConv" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolVisConv" Invert="True" />
        <conv:JlptLevelToColorConverter x:Key="LevelColorConv" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="종이 출력용 PDF 시험지·학습표 생성기" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="단어(한자)·음독/훈독·한국어 뜻 빈칸 퀴즈를 A4 규격으로 생성하여 인쇄 및 채점할 수 있습니다." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportPdfCommand}" Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPrint}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="PDF 저장 및 인쇄" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2-Column Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Options & Presets -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Presets & Type Selection Card -->
                    <Border Style="{StaticResource TailscaleCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="1. 시험지 형식 선택" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <!-- Type 1: Kanji Quiz -->
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding SelectedType, Converter={StaticResource BoolVisConv}, ConverterParameter={x:Static models:WorksheetType.KanjiQuiz}}"
                                         Command="{Binding QuickPresetKanjiQuizCommand}">
                                <StackPanel>
                                    <TextBlock Text="한자 쓰기 테스트 (한자 빈칸)" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="음훈독과 뜻을 보고 한자를 직접 쓰는 연습" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Type 2: Reading Quiz -->
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding SelectedType, Converter={StaticResource BoolVisConv}, ConverterParameter={x:Static models:WorksheetType.ReadingQuiz}}"
                                         Command="{Binding QuickPresetReadingQuizCommand}">
                                <StackPanel>
                                    <TextBlock Text="음독·훈독 읽기 테스트 (읽기 빈칸)" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="한자와 뜻을 보고 히라가나/가타카나 작성" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Type 3: Meaning Quiz -->
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding SelectedType, Converter={StaticResource BoolVisConv}, ConverterParameter={x:Static models:WorksheetType.MeaningQuiz}}"
                                         Command="{Binding QuickPresetMeaningQuizCommand}">
                                <StackPanel>
                                    <TextBlock Text="한국어 뜻 테스트 (뜻 빈칸)" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="한자와 음훈독을 보고 한국어 훈음을 작성" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Type 4: Full Reference Table -->
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding SelectedType, Converter={StaticResource BoolVisConv}, ConverterParameter={x:Static models:WorksheetType.FullStudyTable}}"
                                         Command="{Binding QuickPresetStudyTableCommand}">
                                <StackPanel>
                                    <TextBlock Text="전체 학습 정리표 (전체 표시)" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="한자, 음훈독, 뜻, 예문이 모두 적힌 암기용 표" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Filter & Scope Card -->
                    <Border Style="{StaticResource TailscaleCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="2. 출제 범위 및 문항 수" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <!-- JLPT Level -->
                            <TextBlock Text="JLPT 난이도 레벨" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding SelectedLevel}" SelectedValuePath="Tag" Margin="0,0,0,12">
                                <ComboBoxItem Content="전체 레벨 (N5 ~ N1)" Tag="{x:Static models:JlptLevel.All}" IsSelected="True"/>
                                <ComboBoxItem Content="JLPT N5 (기초)" Tag="{x:Static models:JlptLevel.N5}"/>
                                <ComboBoxItem Content="JLPT N4 (초급)" Tag="{x:Static models:JlptLevel.N4}"/>
                                <ComboBoxItem Content="JLPT N3 (중급)" Tag="{x:Static models:JlptLevel.N3}"/>
                                <ComboBoxItem Content="JLPT N2 (상급)" Tag="{x:Static models:JlptLevel.N2}"/>
                                <ComboBoxItem Content="JLPT N1 (고급)" Tag="{x:Static models:JlptLevel.N1}"/>
                            </ComboBox>

                            <!-- Question Count -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="문항 수" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding QuestionCount, StringFormat='{}{0}문항'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding QuestionCount}" Margin="0,0,0,12"/>

                            <!-- Only Due Items Toggle -->
                            <CheckBox Content="망각 곡선 복습 대기(Due) 한자 우선 출제" IsChecked="{Binding OnlyDueItems}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF Customization Card -->
                    <Border Style="{StaticResource TailscaleCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="3. 시험지 세부 설정" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <TextBlock Text="시험지 제목" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SheetTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <CheckBox Content="단어별 대표 예문 및 파생 어휘 포함" IsChecked="{Binding IncludeExamples}" Margin="0,0,0,8"/>
                            <CheckBox Content="한자 획수 및 부수 정보 표기" IsChecked="{Binding IncludeStrokeCount}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Preview Button -->
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshPreviewCommand}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="랜덤 문항 다시 추출 (미리보기 갱신)" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: A4 Paper Live Preview -->
            <Border Grid.Column="2" Style="{StaticResource TailscaleCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Top Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCardSecondaryBrush}" CornerRadius="10,10,0,0" Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="{Binding CurrentConfig.SheetTypeName, FallbackValue='시험지 미리보기'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CurrentConfig.WorksheetId, StringFormat=' | ID: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding PreviewItems.Count, StringFormat='총 {0}문항'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Preview Table -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" RowBackground="{DynamicResource BgCardBrush}" AlternatingRowBackground="{DynamicResource BgCardSecondaryBrush}"
                                  BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BgCardSecondaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!-- Col 0: Index -->
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>

                                <!-- Col 1: Kanji -->
                                <DataGridTemplateColumn Header="한자 (漢字)" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!-- Visible Kanji -->
                                                <TextBlock Text="{Binding KanjiItem.Kanji}" FontFamily="{StaticResource KanjiFont}"
                                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding HideKanji, Converter={StaticResource InvertBoolVisConv}}"/>
                                                <!-- Blank Writing Box -->
                                                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="4" Width="42" Height="36" Background="{DynamicResource KanjiBoxBgBrush}"
                                                        Visibility="{Binding HideKanji, Converter={StaticResource BoolVisConv}}">
                                                    <TextBlock Text="[빈칸]" FontSize="9" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Col 2: Readings -->
                                <DataGridTemplateColumn Header="음독 / 훈독" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <StackPanel Visibility="{Binding HideReading, Converter={StaticResource InvertBoolVisConv}}">
                                                    <TextBlock Text="{Binding KanjiItem.Onyomi, StringFormat='음: {0}'}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding KanjiItem.Kunyomi, StringFormat='훈: {0}'}" FontSize="11.5" Foreground="{DynamicResource SuccessBrush}"/>
                                                </StackPanel>
                                                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Height="32" Background="{DynamicResource KanjiBoxBgBrush}" Padding="6,4"
                                                        Visibility="{Binding HideReading, Converter={StaticResource BoolVisConv}}">
                                                    <TextBlock Text="[음훈독 쓰기 빈칸]" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Col 3: Meaning -->
                                <DataGridTemplateColumn Header="한국어 뜻" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <StackPanel Visibility="{Binding HideMeaning, Converter={StaticResource InvertBoolVisConv}}">
                                                    <TextBlock Text="{Binding KanjiItem.MeaningKo}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding KanjiItem.MeaningEn}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Height="32" Background="{DynamicResource KanjiBoxBgBrush}" Padding="6,4"
                                                        Visibility="{Binding HideMeaning, Converter={StaticResource BoolVisConv}}">
                                                    <TextBlock Text="[한국어 뜻 쓰기 빈칸]" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Col 4: Level -->
                                <DataGridTemplateColumn Header="레벨" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding KanjiItem.Level, Converter={StaticResource LevelColorConv}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KanjiItem.LevelDisplay}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
