<UserControl x:Class="BenkyoKanji.Views.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:BenkyoKanji.Converters"
             xmlns:models="clr-namespace:BenkyoKanji.Models"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVisConv" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolVisConv" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
        <conv:NullToVisibilityConverter x:Key="InvertNullToVisConv" Invert="True" />
        <conv:EqualityToBoolConverter x:Key="EqualityConv" />
        <conv:JlptLevelToColorConverter x:Key="LevelColorConv" />
        <conv:StudyStatusToBrushConverter x:Key="StudyStatusColorConv" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="일본어 한자·어휘 사전 및 라이브러리" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="JLPT N5~N1 급수별 한자 검색, 정통 한국어 훈음(음·훈) 및 상세 어휘 학습" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleAddCustomCommand}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="새 한자/어휘 등록" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Custom Word Add Panel (Collapsible) -->
        <Border Grid.Row="1" Style="{StaticResource TailscaleCard}" Margin="0,0,0,16"
                Visibility="{Binding IsAddingCustom, Converter={StaticResource BoolVisConv}}">
            <StackPanel>
                <TextBlock Text="새로운 일본어 한자/단어 직접 추가" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="한자 (漢字) *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewKanji, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="음독 (音読み)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewOnyomi, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="훈독 (訓読み)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewKunyomi, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="한국어 뜻 (훈음, 예: 한 일, 배울 학) *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMeaningKo, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="JLPT 난이도" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding NewLevel}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="JLPT N5" Tag="{x:Static models:JlptLevel.N5}" IsSelected="True"/>
                            <ComboBoxItem Content="JLPT N4" Tag="{x:Static models:JlptLevel.N4}"/>
                            <ComboBoxItem Content="JLPT N3" Tag="{x:Static models:JlptLevel.N3}"/>
                            <ComboBoxItem Content="JLPT N2" Tag="{x:Static models:JlptLevel.N2}"/>
                            <ComboBoxItem Content="JLPT N1" Tag="{x:Static models:JlptLevel.N1}"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="총 획수" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewStrokeCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="부수 (Radical)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewRadical, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="영문 뜻" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMeaningEn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleAddCustomCommand}" Content="취소" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCustomKanjiCommand}" Content="저장하기"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Search & Filter List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Input -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="32,8,8,8"/>
                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <!-- JLPT Filter Pills -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                    <RadioButton Style="{StaticResource NavButton}" Content="전체" Padding="8,4" Margin="0,0,4,4"
                                 Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.All}"
                                 IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.All}}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="N5" Padding="8,4" Margin="0,0,4,4"
                                 Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N5}"
                                 IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N5}}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="N4" Padding="8,4" Margin="0,0,4,4"
                                 Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N4}"
                                 IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N4}}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="N3" Padding="8,4" Margin="0,0,4,4"
                                 Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N3}"
                                 IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N3}}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="N2" Padding="8,4" Margin="0,0,4,4"
                                 Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N2}"
                                 IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N2}}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="N1" Padding="8,4" Margin="0,0,4,4"
                                 Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N1}"
                                 IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N1}}"/>
                </WrapPanel>

                <!-- Results List -->
                <Border Grid.Row="2" Style="{StaticResource TailscaleCard}" Padding="4">
                    <ListBox ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedKanji}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="10,8" Background="{DynamicResource BgCardSecondaryBrush}" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Kanji}" FontFamily="{StaticResource KanjiFont}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding MeaningKo}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding AllReadings}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{Binding Level, Converter={StaticResource LevelColorConv}}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelDisplay}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Right: Selected Kanji Inspector -->
            <Border Grid.Column="2" Style="{StaticResource TailscaleCard}">
                <Grid>
                    <!-- Placeholder when nothing selected -->
                    <TextBlock Text="목록에서 한자를 선택하면 상세 정보가 표시됩니다." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedKanji, Converter={StaticResource InvertNullToVisConv}}"/>

                    <!-- Detailed Inspector -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedKanji, Converter={StaticResource NullToVisConv}}">
                        <StackPanel Margin="8">
                            <!-- Hero Section -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource KanjiBoxBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="100" Height="100" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding SelectedKanji.Kanji}" FontFamily="{StaticResource KanjiFont}"
                                               FontSize="58" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{Binding SelectedKanji.Level, Converter={StaticResource LevelColorConv}}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedKanji.LevelDisplay}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        <Border Style="{StaticResource TailscalePill}">
                                            <TextBlock Text="{Binding SelectedKanji.StrokeCount, StringFormat='획수: {0}획'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Large Korean Meaning (Hun-Eum) -->
                                    <TextBlock Text="{Binding SelectedKanji.MeaningKo}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedKanji.MeaningEn, StringFormat='영문 뜻: {0}'}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"
                                               Visibility="{Binding SelectedKanji.MeaningEn, Converter={StaticResource NullToVisConv}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Readings Card -->
                            <Border Style="{StaticResource TailscaleSecondaryCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="음독 (音読み - 카타카나/히라가나)" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedKanji.Onyomi}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="훈독 (訓読み - 히라가나)" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedKanji.Kunyomi}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SRS Current Learning Status Card -->
                            <Border Style="{StaticResource TailscaleSecondaryCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="에빙하우스 망각 곡선 학습 현황" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Text="암기 단계" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <Border Background="{Binding SelectedStudyRecord.Status, Converter={StaticResource StudyStatusColorConv}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding SelectedStudyRecord.Status}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="복습 간격" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedStudyRecord.IntervalDays, StringFormat='{}{0:F1}일'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="다음 복습일" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedStudyRecord.NextReviewDate, StringFormat='{}{0:MM/dd HH:mm}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Example Compounds -->
                            <TextBlock Text="대표 활용 어휘 및 단어 예문" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedKanji.Examples}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10" Background="{DynamicResource BgCardSecondaryBrush}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Word}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Reading, StringFormat='[{0}]'}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Meaning}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Delete Custom Button (If custom) -->
                            <Button Style="{StaticResource DangerButton}" Margin="0,16,0,0" HorizontalAlignment="Right"
                                    Command="{Binding DeleteKanjiCommand}" CommandParameter="{Binding SelectedKanji.Id}"
                                    Visibility="{Binding SelectedKanji.IsCustom, Converter={StaticResource BoolVisConv}}"
                                    Content="이 사용자 단어 삭제"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
