<UserControl x:Class="BenkyoKanji.Views.DictionaryView"
             x:Name="RootUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:BenkyoKanji.Converters"
             xmlns:models="clr-namespace:BenkyoKanji.Models"
             xmlns:vm="clr-namespace:BenkyoKanji.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVisConv" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolVisConv" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
        <conv:NullToVisibilityConverter x:Key="InvertNullToVisConv" Invert="True" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyConv" />
        <conv:EqualityToBoolConverter x:Key="EqualityConv" />
        <conv:JlptLevelToColorConverter x:Key="LevelColorConv" />
        <conv:StudyStatusToBrushConverter x:Key="StudyStatusColorConv" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="일본어 한자·어휘 사전 &amp; 학습 관리" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="한자 검색(훈음·초성·음훈독·가나 교차) 및 수동 공부(누적) 체크, JLPT N5~N1 라이브러리" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleAddCustomCommand}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="새 한자/어휘 등록" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Custom Word Add Panel (Collapsible) -->
        <Border Grid.Row="1" Style="{StaticResource TailscaleCard}" Margin="0,0,0,16"
                Visibility="{Binding IsAddingCustom, Converter={StaticResource BoolVisConv}}">
            <StackPanel>
                <TextBlock Text="새로운 일본어 한자/단어 직접 추가" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="한자 (漢字) *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewKanji, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="음독 (音読み)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewOnyomi, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="훈독 (訓読み)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewKunyomi, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="한국어 뜻 (훈음, 예: 한 일, 배울 학) *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMeaningKo, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="JLPT 난이도" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding NewLevel}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="JLPT N5" Tag="{x:Static models:JlptLevel.N5}" IsSelected="True"/>
                            <ComboBoxItem Content="JLPT N4" Tag="{x:Static models:JlptLevel.N4}"/>
                            <ComboBoxItem Content="JLPT N3" Tag="{x:Static models:JlptLevel.N3}"/>
                            <ComboBoxItem Content="JLPT N2" Tag="{x:Static models:JlptLevel.N2}"/>
                            <ComboBoxItem Content="JLPT N1" Tag="{x:Static models:JlptLevel.N1}"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="총 획수" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewStrokeCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="부수 (Radical)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewRadical, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="영문 뜻" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMeaningEn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleAddCustomCommand}" Content="취소" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCustomKanjiCommand}" Content="저장하기"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search & Multi-Filter Bar -->
        <Border Grid.Row="2" Style="{StaticResource TailscaleCard}" Margin="0,0,0,16" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Search & Level Tabs -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input with Clear Button -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="32,7,28,7" ToolTip="한자, 한국어 뜻(훈음), 초성(예: ㅂㅇㅎ, ㄴㅇ), 음독/훈독(にち/ニチ), 영문 뜻 검색"/>
                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMutedBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearSearchCommand}"
                                Padding="4,2" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,6,0"
                                Visibility="{Binding SearchQuery, Converter={StaticResource NullOrEmptyConv}}" ToolTip="검색어 지우기">
                            <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- JLPT Filter Pills -->
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource NavButton}" Content="전체" Padding="10,5" Margin="0,0,6,0"
                                     Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.All}"
                                     IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.All}}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="N5" Padding="10,5" Margin="0,0,6,0"
                                     Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N5}"
                                     IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N5}}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="N4" Padding="10,5" Margin="0,0,6,0"
                                     Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N4}"
                                     IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N4}}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="N3" Padding="10,5" Margin="0,0,6,0"
                                     Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N3}"
                                     IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N3}}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="N2" Padding="10,5" Margin="0,0,6,0"
                                     Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N2}"
                                     IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N2}}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="N1" Padding="10,5" Margin="0,0,6,0"
                                     Command="{Binding SelectLevelFilterCommand}" CommandParameter="{x:Static models:JlptLevel.N1}"
                                     IsChecked="{Binding SelectedLevel, Converter={StaticResource EqualityConv}, ConverterParameter={x:Static models:JlptLevel.N1}}"/>
                    </WrapPanel>

                    <!-- Count Badge -->
                    <Border Grid.Column="3" Background="{DynamicResource NavActiveBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilteredItems.Count, StringFormat='총 {0}개 한자'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </Grid>

                <!-- Row 2: Study Status Filter & Sorting -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Study Status Filter -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="학습 상태: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox SelectedValue="{Binding SelectedStudyFilter}" SelectedValuePath="Tag" Width="150" Padding="8,4" FontSize="11">
                            <ComboBoxItem Content="전체 학습 상태" Tag="{x:Static vm:StudyStatusFilter.All}" IsSelected="True"/>
                            <ComboBoxItem Content="미학습 (0회)" Tag="{x:Static vm:StudyStatusFilter.Unstudied}"/>
                            <ComboBoxItem Content="학습 중 (1~2회)" Tag="{x:Static vm:StudyStatusFilter.Learning}"/>
                            <ComboBoxItem Content="숙달/복습 (3회 이상)" Tag="{x:Static vm:StudyStatusFilter.Mastered}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Sorting Dropdown -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="정렬 기준: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox SelectedValue="{Binding SelectedSortOption}" SelectedValuePath="Tag" Width="160" Padding="8,4" FontSize="11">
                            <ComboBoxItem Content="JLPT 급수순" Tag="{x:Static vm:KanjiSortOption.Default}" IsSelected="True"/>
                            <ComboBoxItem Content="누적 횟수 적은순 (미학습 우선)" Tag="{x:Static vm:KanjiSortOption.StudyCountAsc}"/>
                            <ComboBoxItem Content="누적 횟수 많은순" Tag="{x:Static vm:KanjiSortOption.StudyCountDesc}"/>
                            <ComboBoxItem Content="총 획수순" Tag="{x:Static vm:KanjiSortOption.StrokeCount}"/>
                            <ComboBoxItem Content="한국어 훈음 가나다순" Tag="{x:Static vm:KanjiSortOption.KoreanName}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Full-Width Results List -->
        <Border Grid.Row="3" Style="{StaticResource TailscaleCard}" Padding="8">
            <Grid>
                <!-- Empty State Message -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding FilteredItems.Count, Converter={StaticResource EqualityConv}, ConverterParameter=0}">
                    <Border Background="{DynamicResource BgCardSecondaryBrush}" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMutedBrush}" Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="검색 조건에 맞는 한자가 없습니다." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="검색어를 변경하거나 JLPT 급수/학습 필터를 초기화해 보세요." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ListBox -->
                <ListBox x:Name="KanjiListBox"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{DynamicResource BgCardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Large Kanji Box -->
                                <Border Grid.Column="0" Background="{DynamicResource KanjiBoxBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Width="60" Height="60" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kanji.Kanji}" FontFamily="{StaticResource KanjiFont}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Middle: All Kanji Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
                                    <!-- Top Row: Meaning and Badges -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Kanji.MeaningKo}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                        <Border Background="{Binding Kanji.Level, Converter={StaticResource LevelColorConv}}" CornerRadius="4" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kanji.LevelDisplay}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        <Border Style="{StaticResource TailscalePill}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kanji.StrokeCount, StringFormat='획수: {0}획'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource TailscalePill}" VerticalAlignment="Center"
                                                Visibility="{Binding Kanji.Radical, Converter={StaticResource NullToVisConv}}">
                                            <TextBlock Text="{Binding Kanji.Radical, StringFormat='부수: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Kanji.MeaningEn, StringFormat='({0})'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding Kanji.MeaningEn, Converter={StaticResource NullToVisConv}}"/>
                                    </StackPanel>

                                    <!-- Readings Row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <!-- Onyomi -->
                                        <Border Background="{DynamicResource NavActiveBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                                Visibility="{Binding Kanji.Onyomi, Converter={StaticResource NullToVisConv}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="음독 " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Kanji.Onyomi}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Kunyomi -->
                                        <Border Background="{DynamicResource NavActiveBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                                Visibility="{Binding Kanji.Kunyomi, Converter={StaticResource NullToVisConv}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="훈독 " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{Binding Kanji.Kunyomi}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Examples preview if any -->
                                    <ItemsControl ItemsSource="{Binding Kanji.Examples}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgCardHoverBrush}" CornerRadius="4" Padding="6,2" Margin="0,2,8,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Word}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Reading, StringFormat=' [{0}]'}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding Meaning, StringFormat=': {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Right: Study Count & Manual Study Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <!-- Study Count Badge -->
                                    <Border Background="{DynamicResource NavActiveBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StudyCountDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- [+1 공부 완료] Manual Check Button -->
                                    <Button Style="{StaticResource SuccessButton}" Command="{Binding IncrementCountCommand}" Padding="10,6" Margin="0,0,6,0" VerticalAlignment="Center"
                                            ToolTip="수동으로 이 한자를 공부했다고 체크하고 누적 횟수를 1회 증가시킵니다.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCheck}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="+1 공부 완료" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- [-1] Decrement Button (visible if studied) -->
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding DecrementCountCommand}" Padding="6,6" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsStudied, Converter={StaticResource BoolVisConv}}" ToolTip="학습 횟수 1회 차감">
                                        <TextBlock Text="-1" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>

                                    <!-- Delete button (if custom item) -->
                                    <Button Style="{StaticResource DangerButton}" Padding="8,6" FontSize="11"
                                            Command="{Binding DataContext.DeleteKanjiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Kanji.Id}"
                                            Visibility="{Binding Kanji.IsCustom, Converter={StaticResource BoolVisConv}}"
                                            Content="삭제" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
